{
	"$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
	"extends": ["@repobuddy/biome/recommended"],
	"files": {
		"includes": [
			"!**/esm",
			"!**/coverage",
			"!**/node_modules",
			"!books",
			"!composer.lock",
			"!examples",
			"!json-schema-specs",
			"!schema",
			"!schema-specs",
			"!skills-lock.json",
			"!pnpm-lock.yaml"
		]
	},
	"linter": {
		"rules": {
			"style": {
				// biome ships this rule at `info`, which does not fail `biome check`.
				// Pin it to `error` so bare `fs`/`path` imports actually break the build.
				"useNodejsImportProtocol": "error"
			}
		}
	},
	"javascript": {
		"formatter": {
			"trailingCommas": "none"
		}
	}
}
