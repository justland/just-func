{
	"name": "just-func-schema",
	"version": "1.0.0",
	"description": "just-func schema and spec validator",
	"repository": "https://github.com/justland/just-func.git",
	"license": "MIT",
	"author": "unional <homawong@gmail.com>",
	"type": "module",
	"bin": "esm/bin.js",
	"exports": {
		".": {
			"types": "./esm/index.d.ts",
			"default": "./esm/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"esm",
		"schema"
	],
	"scripts": {
		"build": "tsdown",
		"check": "biome check",
		"check:fix": "biome check --fix",
		"clean": "rimraf esm coverage .ts",
		"coverage": "vitest run --coverage",
		"depcheck": "depcheck",
		"lint": "biome lint .",
		"prepare": "husky",
		"test": "vitest run",
		"typecheck": "tsc",
		"validate:specs": "node esm/bin.js validate-specs",
		"verify": "run-p check typecheck verify:pkg",
		"verify:pkg": "run-s build coverage validate:specs depcheck"
	},
	"dependencies": {
		"ajv": "^8.20.0",
		"clibuilder": "^10.1.0",
		"jsonc": "^2.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.11",
		"@commitlint/cli": "^21.2.2",
		"@commitlint/config-conventional": "^21.2.2",
		"@repobuddy/biome": "^2.3.1",
		"@types/node": "^26.4.0",
		"@vitest/coverage-v8": "^4.1.11",
		"depcheck": "^1.4.7",
		"husky": "^9.1.7",
		"npm-run-all2": "^9.0.3",
		"rimraf": "^6.0.1",
		"tsdown": "^0.22.14",
		"typescript": "^7.0.2",
		"vitest": "^4.1.11"
	},
	"packageManager": "pnpm@11.20.0"
}
