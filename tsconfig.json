{
	"compilerOptions": {
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"lib": ["es2023"],
		"module": "preserve",
		"moduleResolution": "bundler",
		"newLine": "lf",
		"noEmit": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"skipLibCheck": true,
		"strict": true,
		"target": "es2022",
		"types": ["node"]
	},
	"include": ["ts", "tsdown.config.ts", "vitest.config.ts"]
}
